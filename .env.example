# Copiá este archivo a .env.local (local) y cargá las mismas variables en Vercel → Settings → Environment Variables.

# URL pública del funnel (sin barra final). Opcional: si la dejás vacía se usa la URL de Vercel.
# Cuando tengas el subdominio propio, poné p. ej. https://quiz.tu-dominio.com
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Solo servidor. Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Conversions API (Events Manager → tu dataset → Configuración → Generar token de acceso)
META_CAPI_ACCESS_TOKEN=
# Opcional: código de "Probar eventos" para ver los eventos en tiempo real. Borralo en producción.
META_TEST_EVENT_CODE=
