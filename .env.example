# Copiá este archivo a .env.local (local) y cargá las mismas variables en Vercel → Settings → Environment Variables.

# URL pública del funnel (sin barra final). Se usa en metadatos / Open Graph.
NEXT_PUBLIC_SITE_URL=https://pilateslulu.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Solo servidor. Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Conversions API (Events Manager → tu dataset → Configuración → Generar token de acceso)
META_CAPI_ACCESS_TOKEN=
# Opcional: código de "Probar eventos" para ver los eventos en tiempo real. Borralo en producción.
META_TEST_EVENT_CODE=
