# Copiá este archivo a .env.local (local) y cargá las mismas variables en Vercel → Settings → Environment Variables.

# Clave de la API de Anthropic para la coach virtual. Solo servidor: nunca con prefijo NEXT_PUBLIC_.
# Sin esta clave la app funciona igual y el chat avisa que la coach todavía no está activa.
ANTHROPIC_API_KEY=

# Opcional: modelo de la coach. Por defecto claude-opus-5-5.
COACH_MODEL=

# Opcional: mensajes por día que cada alumna puede mandarle a la coach. Por defecto 20.
NEXT_PUBLIC_COACH_DAILY_LIMIT=

# Secreto para verificar los códigos de activación del plan adicional (Rejuvenecé después de los 50).
# ⚠️ Solo servidor. Tiene que ser EL MISMO valor que ACTIVATION_SECRET en el proyecto de la landing.
ACTIVATION_SECRET=
